{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/consistent-type-assertions": [
      "error",
      {
        "assertionStyle": "never"
      }
    ],
    "typescript/consistent-type-imports": "error",
    "import/no-cycle": "error",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "effect/schema",
            "message": "Use the stable `effect/Schema` module; `effect/schema` is a different, unstable barrel."
          }
        ],
        "patterns": [
          {
            "group": ["foldkit", "foldkit/**"],
            "message": "Only examples may import FoldKit; the adapter, core, client and server never do (DECISIONS 17)."
          }
        ]
      }
    ],
    "no-underscore-dangle": "off",
    "vitest/no-standalone-expect": [
      "error",
      {
        "additionalTestBlockFunctions": ["it.effect", "it.live", "it.scoped", "it.scopedLive", "it.layer"]
      }
    ],
    "vitest/expect-expect": [
      "error",
      {
        "assertFunctionNames": ["expect", "expect*", "assert", "assert*"]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/core/**", "src/client/**", "src/foldkit/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "effect/schema",
                "message": "Use the stable `effect/Schema` module."
              }
            ],
            "patterns": [
              {
                "group": ["**/server", "**/server/**", "echo-sync/server"],
                "message": "Browser/shared code must never import src/server."
              },
              {
                "group": ["foldkit", "foldkit/**"],
                "message": "Only examples may import FoldKit; the adapter, core, client and server never do (DECISIONS 17)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/core/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "effect/schema",
                "message": "Use the stable `effect/Schema` module."
              }
            ],
            "patterns": [
              {
                "group": ["**/server", "**/server/**", "echo-sync/server"],
                "message": "Browser/shared code must never import src/server."
              },
              {
                "group": ["**/client", "**/client/**", "echo-sync/client"],
                "allowTypeImports": true,
                "message": "Core must not import src/client at runtime (SPEC §17); `import type` only. Engine-driving harnesses live in src/client/sync/testing."
              },
              {
                "group": ["foldkit", "foldkit/**"],
                "message": "Only examples may import FoldKit; the adapter, core, client and server never do (DECISIONS 17)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["examples/foldkit/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "effect/schema",
                "message": "Use the stable `effect/Schema` module."
              }
            ]
          }
        ]
      }
    }
  ],
  "ignorePatterns": ["node_modules"]
}
